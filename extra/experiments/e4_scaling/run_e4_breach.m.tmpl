function run_e4_breach(rows_path, meta_path)
%RUN_E4_BREACH  Time real Breach STL_Eval over the E4 scaling grid.
%
%   AUTO-GENERATED by extra/experiments/e4_scaling/run_tool.py (--tool breach).
%   Requires Breach (github.com/decyphir/breach) on the MATLAB path,
%   initialized via InitBreach. Single-trace, like RTAMT: a batch of N is a
%   loop over N STL_Eval calls; signals are regenerated from rng(SEED).

    SEED = @@SEED@@;
    DURATION = @@DURATION@@;
    TS = @@TS@@;
    NS = @@NS@@;
    REPEATS = @@REPEATS@@;
    SLOW_CELL_S = @@SLOW_CELL_S@@;
    FORMULA = '@@FORMULA@@';

    write_meta(meta_path);

    rows = {};
    for ti = 1:numel(TS)
        t = TS(ti);
        time = linspace(0, DURATION, t);
        for ni = 1:numel(NS)
            n = NS(ni);
            % Hoisted out of the timed region: signals, trace systems, formula.
            rng(SEED);
            systems = cell(1, n);
            for k = 1:n
                x = randn(1, t);
                y = randn(1, t);
                BrSys = BreachTraceSystem({'x', 'y'});
                BrSys.AddTrace(struct('time', time, 'X', [x; y]));
                systems{k} = BrSys;
            end
            phi = STL_Formula('phi', FORMULA);
            f = @() eval_all(systems, phi, time);
            [mean_ms, std_ms, repeats] = time_adaptive(f, REPEATS, SLOW_CELL_S);
            rows{end+1} = struct('backend', 'breach-real', ...
                'batch_size', n, 'timesteps', t, ...
                'mean_ms', round(mean_ms, 4), 'std_ms', round(std_ms, 4), ...
                'repeats', repeats, 'status', 'ok'); %#ok<AGROW>
            write_rows(rows_path, rows);
            fprintf('  N=%4d, T=%5d: %9.2f ms (%8.2f ms/trace, x%d)\n', ...
                n, t, mean_ms, mean_ms / n, repeats);
        end
    end
    fprintf('\nE4 Breach column: %d cells\n', numel(rows));
end


%% ==================== Helper functions ====================

function [mean_ms, std_ms, n_repeats] = time_adaptive(f, repeats, slow_cell_s)
    % Mirrors the Python _time_adaptive: one warmup (excluded), then REPEATS
    % timed runs unless the warmup already exceeds SLOW_CELL_S (then run once).
    t0 = tic;
    f();  % warmup (excluded)
    warmup_s = toc(t0);
    if warmup_s > slow_cell_s
        n_repeats = 1;
    else
        n_repeats = repeats;
    end
    timings = zeros(1, n_repeats);
    for i = 1:n_repeats
        t0 = tic;
        f();
        timings(i) = toc(t0) * 1e3;
    end
    mean_ms = mean(timings);
    if n_repeats > 1
        std_ms = std(timings);  % sample std (n-1), like statistics.stdev
    else
        std_ms = 0;
    end
end

function eval_all(systems, phi, time)
    % Single-trace evaluation looped over the N trace systems (outputs
    % discarded: this is the timed kernel).
    for k = 1:numel(systems)
        BrSys = systems{k};
        STL_Eval(BrSys.Sys, phi, BrSys.P, BrSys.P.traj{1}, time);
    end
end

function write_rows(rows_path, rows)
    % rows is a cell array of scalar structs -> a JSON array of objects.
    fid = fopen(rows_path, 'w');
    fprintf(fid, '%s', jsonencode(rows));
    fclose(fid);
end

function write_meta(meta_path)
    fid = fopen(meta_path, 'w');
    fprintf(fid, 'date: %s\n', datestr(now, 31));
    fprintf(fid, 'matlab: %s\n', version);
    try
        breach_dir = fileparts(which('InitBreach'));
        fprintf(fid, 'breach_path: %s\n', breach_dir);
        [st, rev] = system(['git -C "' breach_dir '" rev-parse HEAD']);
        if st == 0
            fprintf(fid, 'breach_commit: %s', rev);
        else
            fprintf(fid, 'breach_commit: (unavailable)\n');
        end
    catch
        fprintf(fid, 'breach_commit: (unavailable)\n');
    end
    fclose(fid);
end
